# ---------------------------------------------------------------------------
# Job Eligibility Tracker - environment
# Copy to .env and fill in. NEVER put API keys in frontend code.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Signing secret for local-mode auth JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploying

# --- Database --------------------------------------------------------------
# Development uses the built-in node:sqlite driver (no install required).
DATABASE_URL=file:./data/jet.db
# For Supabase/PostgreSQL, see supabase/README.md and packages/server/src/db/README-db.md
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Auth ------------------------------------------------------------------
# local   = built-in email+password auth, JWT issued by this server (dev default)
# supabase= validate Supabase-issued JWTs (set SUPABASE_JWT_SECRET)
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# --- Web research (all optional; the engine degrades gracefully) -----------
# At least one search provider unlocks careers-URL discovery for unknown companies.
#   SERPER_API_KEY   https://serper.dev            (Google)
#   BRAVE_API_KEY    https://brave.com/search/api (Brave)
#   TAVILY_API_KEY   https://tavily.com            (Tavily)
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Politeness / compliance limits for outbound crawling.
CRAWL_USER_AGENT=JobEligibilityTracker/0.1 (+https://localhost; contact: you@example.com)
CRAWL_MAX_CONCURRENCY=3
CRAWL_REQUEST_DELAY_MS=1200
CRAWL_TIMEOUT_MS=20000
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_MAX_PAGES_PER_COMPANY=12

# --- AI (optional) ---------------------------------------------------------
# Used ONLY to extract structured requirements and write explanations.
# Deterministic checks always run first and are never overridden by the model.
#   OPENAI_API_KEY -> OpenAI      (default model below)
#   ANTHROPIC_API_KEY -> Anthropic (takes precedence if both set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Email (optional, strictly opt-in) ------------------------------------
# Nothing is sent unless the user enables it in Settings.
RESEND_API_KEY=
EMAIL_FROM=Job Tracker <alerts@example.com>

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=300

# --- Web (Vite) ------------------------------------------------------------
VITE_API_URL=http://localhost:4000
